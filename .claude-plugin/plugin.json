{
  "name": "autoeffort",
  "version": "0.1.0",
  "description": "Effort by work phase: context gathering, planning, implementation, verification",
  "author": { "name": "Dmitry Rudenko" },
  "license": "MIT",
  "types": "./types/index.d.ts",
  "userConfig": {
    "enabled":       { "type": "boolean", "title": "Enabled", "description": "Whether the mod controls effort", "default": true },
    "gather":        { "type": "string", "title": "Context gathering", "description": "Level for the gather phase", "default": "medium", "options": ["medium","high","xhigh","max"] },
    "plan":          { "type": "string", "title": "Planning", "description": "Level for the plan phase", "default": "xhigh", "options": ["medium","high","xhigh","max"] },
    "implement":     { "type": "string", "title": "Implementation", "description": "Level for the implement phase", "default": "medium", "options": ["medium","high","xhigh","max"] },
    "verify":        { "type": "string", "title": "Verification", "description": "Level for the verify phase", "default": "xhigh", "options": ["medium","high","xhigh","max"] },
    "readStreak":    { "type": "number", "title": "Read streak threshold", "description": "How many consecutive read-only steps switch the phase to plan", "default": 3 },
    "verifyPattern": { "type": "string", "title": "Verification command pattern", "description": "RegExp for Bash commands of the verify phase", "default": "(^|[\\s;&|(])((npm|pnpm|yarn|bun)\\s+(run\\s+)?(test|lint|build|typecheck|check)(?![\\w-])|npx\\s+(jest|vitest|eslint|tsc)\\b|(jest|vitest|pytest|eslint|tsc|mypy|ruff)(\\s|$)|cargo\\s+(check|test|clippy)\\b|go\\s+(test|vet)\\b|make\\s+(test|check|lint)\\b)" }
  }
}
